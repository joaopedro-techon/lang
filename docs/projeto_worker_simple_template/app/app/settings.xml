      </repositories>
    </profile>

    <profile>
      <id>ph5</id>
      <repositories>
        <repository>
          <id>itau-ph5-gradle-release</id>
          <name>itau-ph5-gradle-release</name>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-ph5-gradle-release</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>itau-ph5-gradle-release</id>
          <name>itau-ph5-gradle-release</name>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-ph5-gradle-release</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>

  <activeProfiles>
    <activeProfile>artifactory</activeProfile>
    <activeProfile>es8-compopen</activeProfile>
    <activeProfile>itau-sg2-maven-release</activeProfile>
    <activeProfile>itau-sg2-maven-snapshot</activeProfile>
    <activeProfile>itau-ea3-maven-release</activeProfile>
    <activeProfile>itau-ea3-maven-snapshot</activeProfile>
