        </pluginRepository>
      </pluginRepositories>
    </profile>

    <profile>
      <id>es8-compopen</id>
      <repositories>
        <repository>
          <id>itau-comp-open-maven-repo</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-comp-open-maven</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>itau-comp-open-maven-plugin</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-comp-open-maven</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>
    <profile>
      <id>itau-sg2-maven-release</id>
      <repositories>
        <repository>
          <id>itau-sg2-maven-release-repo</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-sg2-maven-release</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>itau-sg2-maven-release-plugin</id>
