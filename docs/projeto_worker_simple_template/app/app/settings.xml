      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>itau-sg2-maven-snapshot-plugin</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-sg2-maven-snapshot</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>

    <profile>
      <id>itau-ea3-maven-release</id>
      <repositories>
        <repository>
          <id>itau-ea3-maven-release-repo</id>
          <url>https://artifactory.prod.aws.cloud.ihf:443/artifactory/itau-ea3-maven-release</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>itau-ea3-maven-release-plugin</id>
          <url>https://artifactory.prod.aws.cloud.ihf:443/artifactory/itau-ea3-maven-release</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>

    <profile>
      <id>itau-ea3-maven-snapshot</id>
      <repositories>
        <repository>
          <id>itau-ea3-maven-snapshot-repo</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-ea3-maven-snapshot/</url>
        </repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository>
          <id>itau-ea3-maven-snapshot-plugin</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-ea3-maven-snapshot/</url>
        </pluginRepository>
      </pluginRepositories>
    </profile>

    <profile>
      <id>ih2.release</id>
      <repositories>
        <repository>
          <id>ih2.release</id>
          <url>https://artifactory.prod.aws.cloud.ihf/artifactory/itau-ih2-maven-release</url>
